{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "getting-warmer-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "vars": {
    // Day #1. Still an open question in the specification (section 11).
    "LAUNCH_DATE": "2026-11-10",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "getting-warmer",
      // Placeholder until the database is created with `wrangler d1 create getting-warmer`.
      // Local development (`wrangler dev`) works without a real ID.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  // NFR-04: 60 requests per minute per IP.
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 },
    },
  ],
  // SECRET and TOKEN_KEY are secrets: `wrangler secret put <name>` in production,
  // `.dev.vars` locally (see .dev.vars.example).
}
