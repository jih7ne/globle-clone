{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "getting-warmer-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "vars": {
    // Day #1 (No. 001).
    "LAUNCH_DATE": "2026-11-11",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "getting-warmer",
      // Production database (region WEUR). `wrangler dev` uses a local copy instead.
      "database_id": "fe1cb40b-eac9-4a52-952b-855a9d38e9a8",
      "migrations_dir": "migrations",
    },
  ],
  // NFR-04: 60 requests per minute per IP.
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 },
    },
  ],
  // SECRET and TOKEN_KEY are secrets: `wrangler secret put <name>` in production,
  // `.dev.vars` locally (see .dev.vars.example).
}
