{
  "name": "getting-warmer",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:web": "npm run dev -w @gw/web",
    "dev:api": "npm run dev -w @gw/api",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build:geo": "npm run build:data -w @gw/geo",
    "test:e2e": "playwright test",
    "report": "allure generate allure-results && allure open allure-report",
    "report:clean": "node -e \"require('fs').rmSync('allure-results',{recursive:true,force:true})\"",
    "lighthouse": "lhci collect && lhci assert",
    "feedback": "npm run feedback -w @gw/api"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.16.1",
    "@playwright/test": "^1.65.0",
    "@vitest/coverage-v8": "^4.1.12",
    "allure": "^3.33.0",
    "allure-playwright": "^3.14.0",
    "allure-vitest": "^3.14.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fast-check": "^4.10.2",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^4.1.12"
  }
}
